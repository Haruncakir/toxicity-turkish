# Virtual Environment
.venv/
venv/
ENV/

# Python Bytecode and Caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Testing and Linting Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Jupyter Notebook Caches
.ipynb_checkpoints/

# Data and Datasets (Exclude raw and processed heavy datasets)
data/raw/
data/interim/
data/downloads/
data/processed/*.parquet
*.parquet
*.xlsx
*.tar.gz
*.zip

# Preserve metadata, checksums, and lockfiles
!data/metadata/
!data/processed/*.json
!data/processed/*.sha256

# Large Model Weights & Checkpoints (Exclude heavy binaries)
checkpoints/
models/checkpoints/
runs/
wandb/
*.safetensors
*.joblib
*.pt
*.bin
*.pth
*.onnx

# Temporary Experiment Outputs, Logs & Rasterized Slides
experiments/outputs/
outputs/
results/
logs/
tmp/
reports/mid_project/slides_png/

# Old legacy presentation
Explainable_Turkish_Implicit_Toxicity_Detection_(2).pptx

# OS Specific
.DS_Store
Thumbs.db
